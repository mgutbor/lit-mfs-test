{
  "version": "1.0.0",
  "baseUrl": "",
  "mfe-dashboard": {
    "name": "mfe-dashboard",
    "baseUrl": "https://dummyjson.com",
    "endpoints": {
      "orders": {
        "endpoint": "/todos",
        "method": "GET",
        "timeout": 5000
      },
      "analytics": {
        "endpoint": "/posts",
        "method": "GET",
        "timeout": 10000
      }
    }
  },
  "mfe-settings": {
    "name": "mfe-settings",
    "baseUrl": "https://dummyjson.com",
    "endpoints": {
      "profile": {
        "endpoint": "/users/1",
        "method": "GET",
        "timeout": 3000
      },
      "update-profile": {
        "endpoint": "/users/1",
        "method": "PUT",
        "timeout": 5000
      }
    }
  }
}
